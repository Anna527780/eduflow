<%- include('partials/header') %>

<h2>Каталог курсов</h2>

<% if (courses.length === 0) { %>
  <p>Пока нет ни одного курса.</p>
<% } %>

<% courses.forEach(course => { %>
  <div class="card">
    <h3><%= course.title %></h3>
    <p><strong>Категория:</strong> <%= course.category %></p>
    <p><strong>Уровень:</strong> <%= course.level %></p>
    <p><strong>Длительность:</strong> <%= course.durationHours %> ч.</p>
    <p><%= course.description %></p>
    <a class="btn" href="/item/<%= course.id %>">Подробнее</a>
  </div>
<% }); %>

<%- include('partials/footer') %>